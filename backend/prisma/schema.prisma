generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  clerkId      String   @unique
  name         String?
  email        String   @unique
  profileImage String?
  createdAt    DateTime @default(now())
}

model Activity {
  id            String   @id
  name          String
  description   String
  location      String
  category      String
  costPerPerson Float
  duration      String
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model Budget {
  id                 String   @id
  tripId             String
  userId             String
  totalTransportCost Float
  totalHotelCost     Float
  totalFoodCost      Float
  totalActivityCost  Float
  totalMiscCost      Float    @default(0)
  totalBudget        Float
  costPerDay         Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime
}

model Expense {
  id        String          @id
  tripId    String
  title     String
  category  ExpenseCategory
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime
}

enum ExpenseCategory {
  Transport
  Hotel
  Food
  Activity
  Misc
}
