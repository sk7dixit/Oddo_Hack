generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  avatar       String?
  authProvider String   @default("email")
  preferences  Json?
  createdAt    DateTime @default(now())
}

model Trip {
  id          String   @id @default(uuid())
  title       String
  destination String
  startDate   DateTime?
  endDate     DateTime?
  members     String[] // Array of user emails
  itinerary   Json?    // Array of objects
  budget      Json?    // Budget object
  createdBy   String
  createdAt   DateTime @default(now())
}

model Activity {
  id            String   @id @default(uuid())
  name          String
  description   String
  location      String
  category      String
  costPerPerson Float
  duration      String
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Budget {
  id                 String   @id @default(uuid())
  tripId             String
  userId             String
  totalTransportCost Float
  totalHotelCost     Float
  totalFoodCost      Float
  totalActivityCost  Float
  totalMiscCost      Float    @default(0)
  totalBudget        Float
  costPerDay         Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Expense {
  id        String          @id @default(uuid())
  tripId    String
  title     String
  category  ExpenseCategory
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum ExpenseCategory {
  Transport
  Hotel
  Food
  Activity
  Misc
}
