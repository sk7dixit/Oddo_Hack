// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  bio         String?
  avatar      String?
  instagramId String?
  facebookId  String?
  trips       Trip[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TripStatus {
  Planning
  Confirmed
  Draft
}

model Trip {
  id          String     @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      TripStatus @default(Planning)
  image       String?
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  stops       TripStop[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model TripStop {
  id            String    @id @default(uuid())
  tripId        String
  cityId        String
  orderIndex    Int
  arrivalDate   DateTime?
  departureDate DateTime?
  notes         String?
  trip          Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city          City      @relation(fields: [cityId], references: [id])
  createdAt     DateTime  @default(now())
}

model City {
  id        String     @id @default(uuid())
  name      String
  country   String
  state     String?
  image     String?
  stops     TripStop[]
  createdAt DateTime   @default(now())
}
