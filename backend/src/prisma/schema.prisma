generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id            String   @id @default(uuid())
  name          String
  description   String
  location      String
  category      String
  costPerPerson Float
  duration      String
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Budget {
  id                 String   @id @default(uuid())
  tripId             String
  userId             String
  totalTransportCost Float
  totalHotelCost     Float
  totalFoodCost      Float
  totalActivityCost  Float
  totalMiscCost      Float    @default(0)
  totalBudget        Float
  costPerDay         Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum ExpenseCategory {
  Transport
  Hotel
  Food
  Activity
  Misc
}

model Expense {
  id        String          @id @default(uuid())
  tripId    String
  title     String
  category  ExpenseCategory
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}
